# Optional during local review. Production URL must be HTTPS.
SITE_URL=
SITE_INDEXABLE=false
# Postgres (Neon in production; use the pooled connection string). Production builds apply db/schema.sql automatically; locally run npm run db:migrate.
DATABASE_URL=
# Vercel Cron sends this as a Bearer token to /api/cron/inventory (hourly at :15, see vercel.json).
CRON_SECRET=
# dealr.cloud confirmed hourly full active-inventory exports on October 14, 2026.
DEALR_FEED_MODE=full
DEALR_DEALER_ID=
# ADF inquiries: authenticated SMTP with certificate-verified TLS (465 or STARTTLS).
# The host supplies these credentials and verifies the sender domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Provider-confirmed destination; change only with dealership approval.
ADF_LEAD_TO=dealer-the-used-car-factory@leads.dealrcloud.com
# dealr.cloud credit application iframe. Defaults to the staging URL they supplied; set the production URL when they provide it.
CREDIT_APPLICATION_URL=
# Bucket owned by the dealership (AWS Transfer Family target); AWS_* credentials are read by the SDK.
S3_BUCKET_NAME=
# Exact object key of the hourly CSV; find it with scripts/list-s3-inventory.ts.
S3_INVENTORY_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Vercel presets AWS_REGION to the function region; set this explicitly to the bucket region.
AWS_REGION=us-east-2
