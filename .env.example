# Optional during local review. Production URL must be HTTPS.
SITE_URL=
SITE_INDEXABLE=false
# A dealer-approved, normalized HTTPS JSON feed. See docs/INTEGRATIONS.md.
INVENTORY_FEED_URL=
INVENTORY_FEED_TOKEN=
# Alternatively, private normalized JSON written by npm run inventory:import.
INVENTORY_FILE_PATH=
# dealr.cloud confirmed hourly full active-inventory exports on October 14, 2026.
DEALR_FEED_MODE=full
DEALR_DEALER_ID=
DEALR_SFTP_HOST=
DEALR_SFTP_PORT=22
DEALR_SFTP_USERNAME=
DEALR_SFTP_PASSWORD=
DEALR_SFTP_PRIVATE_KEY_PATH=
DEALR_SFTP_PASSPHRASE=
# Verified SHA256 hex fingerprint, obtained independently from the server owner.
DEALR_SFTP_HOST_SHA256=
# Exact completed CSV path; do not use a directory or wildcard.
DEALR_SFTP_PATH=
# ADF inquiries: authenticated SMTP with certificate-verified TLS (465 or STARTTLS).
# The host supplies these credentials and verifies the sender domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Provider-confirmed destination; change only with dealership approval.
ADF_LEAD_TO=dealer-the-used-car-factory@leads.dealrcloud.com
