# Optional during local review. Production URL must be HTTPS.
SITE_URL=
SITE_INDEXABLE=false
# A dealer-approved, normalized HTTPS JSON feed. See docs/INTEGRATIONS.md.
INVENTORY_FEED_URL=
INVENTORY_FEED_TOKEN=
# Alternatively, private normalized JSON written by npm run inventory:import.
INVENTORY_FILE_PATH=
# Set full only after dealr.cloud confirms complete active-inventory exports.
DEALR_FEED_MODE=
DEALR_DEALER_ID=
DEALR_SFTP_HOST=
DEALR_SFTP_PORT=22
DEALR_SFTP_USERNAME=
DEALR_SFTP_PASSWORD=
DEALR_SFTP_PRIVATE_KEY_PATH=
DEALR_SFTP_PASSPHRASE=
# Verified SHA256 hex fingerprint, obtained independently from the server owner.
DEALR_SFTP_HOST_SHA256=
# Exact completed CSV path; do not use a directory or wildcard.
DEALR_SFTP_PATH=
# Approved HTTPS CRM/lead relay. No lead is accepted until this is configured.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# On-site credit application. Enable only after provider mapping and disclosures are approved.
# Use a dedicated authenticated HTTPS relay for financial data, never the general lead relay.
FINANCE_APPLICATION_ENABLED=false
FINANCE_WEBHOOK_URL=
FINANCE_WEBHOOK_TOKEN=
